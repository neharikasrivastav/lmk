# Copy to .env for local development, and add the same names in your host's
# environment settings (e.g. Vercel → Project → Settings → Environment Variables).
# Never commit real values.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser or prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio → Get API key (free tier). Powers the companion chat.
GEMINI_API_KEY=
# Optional: any OpenAI-compatible provider/model.
# AI_BASE_URL=https://api.groq.com/openai/v1   (any OpenAI-compatible endpoint; leave unset for Gemini)
# AI_MODEL=gemini-3.5-flash-lite

# HeiGIT / OpenRouteService → Dashboard (free Standard key). Live walking directions.
ORS_API_KEY=
